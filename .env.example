# ── Required ─────────────────────────────────────────────────────────
# Your Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Password for the /admin panel. Use a long, unique one.
ADMIN_PASSWORD=change-me-to-something-long

# Secret used to sign admin sessions. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── Database ─────────────────────────────────────────────────────────
# Local development: a file next to the project (default if unset).
DATABASE_URL=file:staydesk.db
# Production (Vercel etc.): a Turso database — free tier is plenty.
#   DATABASE_URL=libsql://your-db-name.turso.io
#   DATABASE_AUTH_TOKEN=...
DATABASE_AUTH_TOKEN=

# ── Optional ─────────────────────────────────────────────────────────
# Model and pricing (USD per million tokens) used for the cost estimate.
ANTHROPIC_MODEL=claude-haiku-4-5
PRICE_INPUT_PER_MTOK=1
PRICE_OUTPUT_PER_MTOK=5

# Email new booking inquiries to each business's owner email.
# Leave SMTP_HOST empty to disable (leads are still saved in the admin).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="StayDesk <no-reply@example.com>"

# Public base URL, used in embed snippets (e.g. https://staydesk.vercel.app)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
